# Database
# PostgreSQL connection string (Neon, Supabase, or other PostgreSQL provider)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# Better Auth Configuration
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL for Better Auth (server-side)
# For production, use your deployed URL: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000
# Base URL for Better Auth (client-side, must be public)
# For production, use your deployed URL: https://yourdomain.com
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Resend Email Service
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Sender email address (must be verified in Resend)
# For testing, you can use: onboarding@resend.dev
RESEND_FROM_EMAIL=

# Cron Job Authentication
# Generate secret with: openssl rand -base64 32
# This secret is used to authenticate cron job requests from Vercel
CRON_SECRET=
