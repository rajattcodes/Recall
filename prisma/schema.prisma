// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ProblemStatus {
  fresh
  active
  failed
  mastered
}

enum ReminderStage {
  day_3
  day_10
  day_30
  completed
}

enum AttemptResult {
  solved
  failed
}

// Better Auth Tables
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  accountId        String  @map("account_id")
  providerId        String  @map("provider_id")
  accessToken       String? @map("access_token")
  refreshToken      String? @map("refresh_token")
  idToken           String? @map("id_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope             String?
  password          String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime  @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([identifier, value])
  @@map("verifications")
}

// Application Tables
model CanonicalPattern {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  customPatterns CustomPattern[]
  problems      Problem[]

  @@map("canonical_patterns")
}

model CustomPattern {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  name               String
  canonicalPatternId String   @map("canonical_pattern_id")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  canonicalPattern CanonicalPattern @relation(fields: [canonicalPatternId], references: [id])
  problems         Problem[]

  @@unique([userId, name])
  @@map("custom_patterns")
}

model Problem {
  id                 String        @id @default(cuid())
  userId             String        @map("user_id")
  title              String
  leetcodeUrl        String        @map("leetcode_url")
  canonicalPatternId String        @map("canonical_pattern_id")
  customPatternId    String?       @map("custom_pattern_id")
  status             ProblemStatus @default(fresh)
  reminderStage      ReminderStage @default(day_3) @map("reminder_stage")
  nextReminderDate   DateTime      @map("next_reminder_date")
  failureCount       Int           @default(0) @map("failure_count")
  totalAttempts      Int           @default(0) @map("total_attempts")
  createdAt          DateTime      @default(now()) @map("created_at")
  lastAttemptedAt    DateTime?     @map("last_attempted_at")

  // Relations
  canonicalPattern CanonicalPattern @relation(fields: [canonicalPatternId], references: [id])
  customPattern    CustomPattern?   @relation(fields: [customPatternId], references: [id])
  attemptHistory   AttemptHistory[]

  @@index([userId, nextReminderDate])
  @@index([status])
  @@index([canonicalPatternId])
  @@map("problems")
}

model AttemptHistory {
  id          String        @id @default(cuid())
  problemId   String        @map("problem_id")
  attemptedAt DateTime      @default(now()) @map("attempted_at")
  result      AttemptResult
  notes       String?

  // Relations
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("attempt_history")
}
